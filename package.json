{
  "name": "thirukkural.xyz",
  "version": "1.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/generate-version.mjs && ng build && node scripts/generate-sitemap.mjs",
    "build:dev": "ng build --configuration development",
    "preview": "npm run build && npx --yes http-server dist/thirukkural/browser -p 4300 -c-1",
    "test": "ng test",
    "fonts": "node scripts/fetch-fonts.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "version": "node scripts/generate-version.mjs",
    "package": "npm run build && node scripts/package-release.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.7",
    "@angular/ssr": "^22.1.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.11.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
